{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Video Editor",
  "version": "0.2.0",
  "identifier": "dev.local.home-video-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Home Video Editor",
        "width": 1600,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
